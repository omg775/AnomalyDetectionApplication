# Environment for the backend and the ML service. Placeholders only.
#
#   cp .env.example .env      # .env is ignored by git; never commit it
#   set -a; . ./.env; set +a  # load it into the current shell (in every terminal you start a service from)
#
# Values containing $ (the BCrypt hash) must stay in single quotes.

# ---- Backend: database (required) ----
# Local PostgreSQL: jdbc:postgresql://localhost:5432/anomaly
# Supabase (Session pooler): jdbc:postgresql://<host>:5432/postgres?sslmode=require&prepareThreshold=0
DB_URL='jdbc:postgresql://localhost:5432/anomaly'
DB_USERNAME='<db-user>'
DB_PASSWORD='<db-password>'
# Optional, default 1 (Supabase session pooler limit)
DB_POOL_MAX_SIZE=1

# ---- Backend: security (required) ----
# At least 32 bytes, for example the output of: openssl rand -hex 32
JWT_SECRET='<random-secret-at-least-32-bytes>'
ADMIN_USERNAME='admin'
# BCrypt hash of the admin password, never the plaintext. See README, "Admin password hash".
ADMIN_PASSWORD='<bcrypt-hash-starting-with-$2a$>'

# ---- Shared by backend and ML service (required) ----
# Same value on both sides, for example: openssl rand -hex 32
ML_API_KEY='<random-shared-secret>'

# ---- Backend: optional ----
ML_SERVICE_BASE_URL='http://127.0.0.1:8010'
# Comma-separated browser origins; empty means no cross-origin access ("*" only with SPRING_PROFILES_ACTIVE=dev)
CORS_ALLOWED_ORIGINS=''
# Protocols accepted by the CSV import
CSV_ALLOWED_PROTOCOLS='TCP,UDP,ICMP'
CSV_MAX_ROWS=100000

# ---- ML service: optional ----
# Absolute folder for trained models; empty means <ml-service>/models
MODEL_DIR=''
# Maximum request body in bytes (default 50 MiB)
MAX_REQUEST_BYTES=52428800
# Only for local development: lets the ML service start without ML_API_KEY
ALLOW_INSECURE_DEV=false
